{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "ds4",
    "ds4-qwen",
    "local-omlx",
    "qwen-subscription",
    "qwencloud",
    "deepseek",
    "omlx-glimmer",
    "mistral",
    "nazryzen",
    "guardtest"
  ],
  "permission": "allow",
  "mcp": {
    "playwright": { "enabled": false },
    "brave": { "enabled": false },
    "tavily": { "enabled": false },
    "codebase-memory-mcp": { "enabled": false },
    "context7": { "enabled": false }
  },
  "provider": {
    "guardtest": {
      "name": "Guard Test",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "test"
      },
      "models": {
        "guardtest-model": {
          "name": "Guard Test",
          "limit": { "context": 100000, "output": 4000 }
        }
      }
    }
  }
}
